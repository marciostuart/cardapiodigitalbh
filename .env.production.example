APP_NAME="Cardapio Digital BH"
# Troque a versao quando revisar cada documento; a nova versao pede novo aceite no painel.
CARDAPIO_TERMS_VERSION=2026-10-29
CARDAPIO_PRIVACY_VERSION=2026-10-29.1
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cardapiodigitalbh.com.br
APP_BASE_DOMAIN=cardapiodigitalbh.com.br
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cardapiodigitalbh
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cardapiodigitalbh
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Cardapio Digital BH"

# Evolution API (use primeiro uma instancia de teste)
# 1. Preencha a URL HTTPS base e a chave da API.
# 2. Gere um segredo longo e aleatorio em EVOLUTION_WEBHOOK_SECRET.
# 3. Na Evolution, configure https://cardapiodigitalbh.com.br/webhooks/evolution
#    e envie esse mesmo segredo no cabecalho X-Webhook-Secret.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Mercado Pago (credenciais da aplicacao; tokens de cada lojista ficam criptografados no banco)
# 1. Crie a aplicacao no Mercado Pago e comece com credenciais de teste.
# 2. Cadastre exatamente MERCADOPAGO_REDIRECT_URI como URL de retorno da aplicacao.
# 3. Configure o evento Pagamentos no Webhook para a URL abaixo; copie o segredo gerado.
# 4. Mantenha TEST_MODE=true ate terminar a homologacao. Cada lojista conecta a conta pelo painel.
# 5. PKCE deve permanecer habilitado na aplicacao Mercado Pago para proteger o OAuth.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://cardapiodigitalbh.com.br/painel/pagamentos/mercado-pago/retorno
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_PKCE_ENABLED=true

# Web Push
# Nao invente estas chaves manualmente. Depois de implantar, na VPS rode:
#   cd /opt/cardapiodigitalbh && sh deploy/setup-webpush.sh
# O script gera as chaves direto no .env protegido sem mostra-las no terminal.
# Depois, atualize somente a stack cardapiodigitalbh para carregar as chaves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:falecom@cardapiodigitalbh.com.br
